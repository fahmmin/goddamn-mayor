# Copy to .env and fill in. .env is gitignored and never leaves your machine.
#
#   cp .env.example .env
#
# DEPLOYER_PRIVATE_KEY must be a FRESH key used only for this project on
# Sepolia. Never reuse a key that has touched mainnet, and never paste one
# into a chat, an issue, or a commit.

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
DEPLOYER_PRIVATE_KEY=0xYOUR_FRESH_SEPOLIA_KEY

# The city's parent name. Day one confirms this is free and claims it.
CITY_ROOT=cityhall.eth

# Filled in by the deploy scripts as they run
CITY_ORACLE_ADDRESS=
SUBGRAPH_URL=
PRIVY_APP_ID=

# Subgraph Studio deploy key, from thegraph.com/studio - needed only by
# `npm --prefix subgraph run deploy`. Nothing in the browser reads it.
GRAPH_DEPLOY_KEY=

# The saved city, so a mayor picks up the same one on another machine.
# Only the project URL is needed here: the browser talks to the city Edge
# Function, never to the database, so no Supabase key ships to the client.
# NEXT_PUBLIC_SUPABASE_URL is accepted too - that is the name Supabase's own
# snippets use. Leave blank and the city simply stays in localStorage.
SUPABASE_URL=

# These two are set as Edge Function secrets in the Supabase dashboard, NOT
# read from here, and must never reach web3/config.json:
#   PRIVY_VERIFICATION_KEY   public key from the Privy dashboard
#   SUPABASE_SERVICE_ROLE_KEY   injected by the platform
