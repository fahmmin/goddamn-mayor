# Everything here is either a secret, a local tool, or something that would be
# SERVED TO THE PUBLIC if it shipped. outputDirectory is the repo root, so
# anything not excluded is a URL.

.env
.env.*
!.env.example

# Deploy machinery. contracts/ and chain/ hold the deployer's tooling; nothing
# in the browser reads them, and chain/deploy.js reads .env.
