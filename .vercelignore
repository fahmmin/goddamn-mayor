chain/deploy.js
chain/push-city.js
chain/verify-gate.js
chain/preflight.js
chain/probe-registrar.js
chain/build/
chain/node_modules/
contracts/
subgraph/
supabase/

# Local development only
tools/city-server.js
tools/diag.js
tools/render-check.js
output/

# Tests
**/*.test.js
smoke.js

# Editor and agent scratch
.claude/
